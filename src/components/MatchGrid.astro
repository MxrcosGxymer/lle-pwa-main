---
import ResultBadge from './ResultBadge.astro';
import ScoreBadge from './ScoreBadge.astro';
import VenueLink from './VenueLink.astro';
import MovedBadge from './MovedBadge.astro';
import type { MatchRow } from '../lib/db';
import { formatTime, formatTurno, isTbdVenue, movedLabel, teamOutcome } from '../lib/format';

interface Props {
	matches: MatchRow[];
}

const { matches } = Astro.props;

/**
 * Unconfirmed venues show the turno label instead of the raw hour, since the
 * time is only a pre-structured slot until the admin confirms it. The label is
 * trusted HTML (superscript ordinal), so it is rendered with `set:html`.
 */
const timeLabel = (m: MatchRow) =>
	isTbdVenue(m.venue_maps) ? formatTurno(m.time) || formatTime(m.time) : formatTime(m.time);
---

<div class="mt-3 grid gap-3 sm:grid-cols-2">
	{
		matches.map((m) => (
			<div class="relative block rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
				<a
					href={`/partidos/${m.id}`}
					class="absolute inset-0 rounded-xl"
					aria-label={`${m.home_team} vs ${m.away_team}`}
				/>
				<div
					class:list={[
						'mb-2 flex flex-wrap items-center gap-2 text-xs text-gray-500',
						m.venue_name && 'min-h-4',
					]}
				>
					{timeLabel(m) && <span set:html={timeLabel(m)} />}
					{m.status === 'scheduled' && m.live_home_score != null && (
						<span class="inline-flex items-center gap-1.5 rounded-full bg-red-600 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white">
							<span class="h-1.5 w-1.5 animate-pulse rounded-full bg-white" />
							En directo · {m.live_period && m.live_period > 4 ? `PR${m.live_period - 4}` : `Q${m.live_period ?? 1}`}
						</span>
					)}
					{movedLabel(m.original_date, m.date) && (
						<MovedBadge originalDate={m.original_date} date={m.date} size="sm" />
					)}
				</div>
				<VenueLink
					name={m.venue_name}
					short={m.venue_short}
					mapsUrl={m.venue_maps}
					class="absolute right-4 top-4 z-10 text-xs leading-4 text-gray-500 hover:text-[#79131f] hover:underline"
				/>
				<div class="flex items-center justify-between gap-3">
					<div class="flex min-w-0 flex-1 items-center gap-1.5">
						<span
							class="truncate font-medium"
							title={m.home_team}
							data-name-full={m.home_team}
							data-name-short={m.home_short}
						>
							{m.home_short}
						</span>
						{(() => {
							const outcome = teamOutcome(m, 'home');
							return outcome && <ResultBadge variant={outcome} />;
						})()}
					</div>
					<ScoreBadge
						home={m.status === 'scheduled' && m.live_home_score != null ? m.live_home_score : m.home_score}
						away={m.status === 'scheduled' && m.live_away_score != null ? m.live_away_score : m.away_score}
						variant="card"
					/>
					<div class="flex min-w-0 flex-1 items-center justify-end gap-1.5">
						{(() => {
							const outcome = teamOutcome(m, 'away');
							return outcome && <ResultBadge variant={outcome} />;
						})()}
						<span
							class="truncate text-right font-medium"
							title={m.away_team}
							data-name-full={m.away_team}
							data-name-short={m.away_short}
						>
							{m.away_short}
						</span>
					</div>
				</div>
			</div>
		))
	}
</div>
