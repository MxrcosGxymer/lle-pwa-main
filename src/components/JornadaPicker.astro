---
import { formatDate } from '../lib/format';
import type { PickerSection } from '../lib/calendario';

interface Props {
	sections: PickerSection[];
	initialId: string;
}

const { sections, initialId } = Astro.props;

const initialLabel = sections.find((section) => section.id === initialId)?.label ?? '';
---

<button
	type="button"
	class="jornada-trigger flex min-w-0 items-center gap-1.5 text-left text-base font-semibold text-gray-900 transition-colors hover:text-[#641B24] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#641B24] sm:text-lg"
	data-jornada-toggle
	aria-haspopup="listbox"
	aria-expanded="false"
>
	<span class="truncate" data-jornada-label title={initialLabel}>{initialLabel}</span>
	<svg
		class="jornada-chevron shrink-0 text-gray-500"
		width="16"
		height="16"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2.5"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="m6 9 6 6 6-6"></path>
	</svg>
</button>

<ul
	class="jornada-menu fixed z-50 max-h-[60dvh] overflow-y-auto overscroll-contain rounded-xl border border-gray-200 bg-white py-1 shadow-lg"
	data-jornada-menu
	role="listbox"
	aria-label="Jornadas"
	hidden
>
	{
		sections.map((section) => (
			<li
				role="option"
				tabindex="-1"
				data-jornada-value={section.id}
				data-jornada-last={section.lastDate}
				data-jornada-label={section.label}
				aria-selected={section.id === initialId ? 'true' : 'false'}
				aria-label={section.label}
				class="jornada-option flex cursor-pointer items-center gap-2 px-3 py-2 text-sm outline-none hover:bg-[#641B24]/5 focus:bg-[#641B24]/5"
			>
				<span class="jornada-option-short w-7 shrink-0 font-display text-base leading-none text-[#641B24]">
					{section.short}
				</span>
				<span class="jornada-option-date text-gray-600">{formatDate(section.date)}</span>
				<span class="jornada-option-dot ml-auto h-1.5 w-1.5 rounded-full bg-[#641B24]" aria-hidden="true" />
			</li>
		))
	}
</ul>

<style>
	/*
	 * The trigger reads as a heading at the end of the bar rather than a pill,
	 * so it carries no border or background: the chevron and the brand-red
	 * open state are what mark it as interactive.
	 */
	.jornada-trigger[data-open] {
		color: #641b24;
	}

	.jornada-chevron {
		transition: transform 200ms ease-out;
	}

	.jornada-trigger[data-open] .jornada-chevron {
		transform: rotate(180deg);
	}

	/* Headless-UI-style fade + slide-down for the dropdown. */
	.jornada-menu {
		opacity: 0;
		transform: translateY(-4px);
		transition:
			opacity 100ms ease-out,
			transform 100ms ease-out;
	}

	.jornada-menu[data-open] {
		opacity: 1;
		transform: translateY(0);
	}

	/* Played sections fade back; the next one keeps the brand red plus a dot. */
	.jornada-option[data-played] {
		opacity: 0.45;
	}

	.jornada-option[data-played] .jornada-option-short {
		color: #6b7280;
	}

	.jornada-option-dot {
		opacity: 0;
	}

	.jornada-option[data-next] .jornada-option-dot {
		opacity: 1;
	}

	.jornada-option[aria-selected='true'] {
		background-color: rgb(100 27 36 / 0.05);
	}

	@media (prefers-reduced-motion: reduce) {
		.jornada-chevron,
		.jornada-menu {
			transition: none;
		}
	}
</style>
