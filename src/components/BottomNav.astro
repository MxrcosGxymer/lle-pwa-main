const isActive = (href: string) =>
	href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<nav
	id="bottom-nav"
	aria-label="Navegación principal (móvil)"
	class="glass-nav fixed left-1/2 bottom-[calc(env(safe-area-inset-bottom)+0.5rem)] z-20 w-[calc(100%-1.5rem)] max-w-md -translate-x-1/2 rounded-2xl lg:hidden"
>
	<span id="bottom-nav-pill" class="bottom-nav-pill" aria-hidden="true"></span>
	<ul class="relative flex h-[3.75rem] items-stretch px-1">
		{
			links.map((l) => (
				<li class="flex flex-1">
					<a
						href={l.href}
						aria-current={isActive(l.href) ? 'page' : undefined}
						class={
							'flex w-full flex-col items-center justify-center gap-0.5 rounded-xl text-[10px] leading-none transition-colors ' +
							(isActive(l.href)
								? 'font-bold text-white'
								: 'font-medium text-white/80 hover:text-white')
						}
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							class="h-5 w-5"
							viewBox="0 0 256 256"
							aria-hidden="true"
							fill="currentColor"
							set:html={isActive(l.href) ? l.iconFill : l.icon}
						/>
						<span>{l.label}</span>
					</a>
				</li>
			))
		}
	</ul>
</nav>

<script>
	const nav = document.getElementById('bottom-nav');
	const pill = document.getElementById('bottom-nav-pill');

	if (nav && pill) {
		// Gradient visible on each side of the active label, the bar's inner
		// padding (matches the ul's px-1) and the minimum gap to a neighbour.
		const PAD = 8;
		const EDGE = 4;
		const NEIGHBOUR = 4;

		// The bloom only plays when we arrived by tapping a tab, never on a
		// plain load / reload / pull-to-refresh.
		const SESSION_KEY = 'lle-nav-tap';
		let fromTap = false;
		try {
			fromTap = sessionStorage.getItem(SESSION_KEY) === '1';
			sessionStorage.removeItem(SESSION_KEY);
		} catch {
			fromTap = false;
		}

		const place = () => {
			const active = nav.querySelector<HTMLAnchorElement>('a[aria-current="page"]');
			const label = active?.querySelector('span');
			const item = active?.closest('li');
			if (!active || !label || !item) return;

			const navRect = nav.getBoundingClientRect();
			const itemRect = active.getBoundingClientRect();
			const textRect = label.getBoundingClientRect();

			const siblings = [...(item.parentElement?.children ?? [])];
			const index = siblings.indexOf(item);
			const prev = siblings[index - 1]?.querySelector('span')?.getBoundingClientRect();
			const next = siblings[index + 1]?.querySelector('span')?.getBoundingClientRect();

			// Furthest the pill may reach without touching a neighbour or the bar edge.
			const minLeft = Math.max(navRect.left + EDGE, prev ? prev.right + NEIGHBOUR : -Infinity);
			const maxRight = Math.min(navRect.right - EDGE, next ? next.left - NEIGHBOUR : Infinity);

			// Short labels keep the slot width; long ones ("Clasificación") grow
			// symmetrically by PAD, or by whatever room is left, never under 2px.
			const slotPad = Math.max(0, (itemRect.width - textRect.width) / 2);
			const pad = Math.max(
				slotPad,
				Math.min(PAD, textRect.left - minLeft, maxRight - textRect.right),
				2
			);

			pill.style.width = `${textRect.width + pad * 2}px`;
			pill.style.transform = `translateX(${textRect.left - pad - navRect.left}px)`;
			nav.classList.add('is-ready');
			if (fromTap) pill.classList.add('pill-grow');
		};

		// Flag the next page load as coming from a real tab tap. Adding a class
		// is idempotent, so re-placing on resize never replays the animation.
		nav.addEventListener('click', (event) => {
			if (event instanceof MouseEvent && (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)) {
				return;
			}
			if (!(event.target instanceof Element)) return;
			const link = event.target.closest<HTMLAnchorElement>('a[href]');
			if (!link || link.getAttribute('aria-current') === 'page') return;
			try {
				sessionStorage.setItem(SESSION_KEY, '1');
			} catch {
				/* storage unavailable: just skip the bloom */
			}
		});

		place();
		window.addEventListener('resize', place);
		window.addEventListener('orientationchange', place);
		window.addEventListener('pageshow', place);
		if (document.fonts?.ready) void document.fonts.ready.then(place);
	}
</script>
