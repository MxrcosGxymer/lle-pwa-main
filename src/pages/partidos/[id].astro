														</p>
													)}
												</div>
											</div>
											<div class="flex shrink-0 items-center gap-1.5 font-mono text-xs text-gray-500">
												{ev.per != null && (
													<span class="rounded bg-gray-100 px-1.5 py-0.5 font-semibold text-gray-700">
														{ev.per > 4 ? `PR${ev.per - 4}` : `Q${ev.per}`}
													</span>
												)}
												<span>{ev.clk || ev.time || ''}</span>
											</div>
										</div>
									))
								) : (
									<p class="p-8 text-center text-sm text-gray-500">
										Aún no hay jugadas registradas para este partido.
									</p>
