---
import Layout from '../../layouts/Layout.astro';
import ThTooltip from '../../components/ThTooltip.astro';
import TeamBadge from '../../components/TeamBadge.astro';
import ScoreBadge from '../../components/ScoreBadge.astro';
import VenueLink from '../../components/VenueLink.astro';
import MovedBadge from '../../components/MovedBadge.astro';
import QuarterChart from '../../components/QuarterChart.astro';
import type { BoxScoreRow } from '../../lib/db';
import { getLiveMatch, getMatch, getMatchBoxScore } from '../../lib/db';
import { MAX_FOULS } from '../../lib/validation/match-acta';
import {
	formatDate,
	formatTime,
	formatTurno,
	isTbdVenue,
	movedLabel,
	teamOutcome,
	type TeamOutcome,
} from '../../lib/format';

interface LivePlayerStat {
	number: string | number;
	name: string;
	points: number;
	fg2: number;
	fg3: number;
	ftm: number;
	fta: number;
	fouls: number;
}

interface PbpEvent {
	id?: string | number;
	t?: number;
	team?: string;
	color?: string;
	type?: string;
	per?: number;
	clk?: string;
	icon?: string;
	desc?: string;
	txt?: string;
	text?: string;
	time?: string;
}

const rawId = Number(Astro.params.id);
const match = Number.isNaN(rawId) ? null : await getMatch(rawId);
const rows = match ? await getMatchBoxScore(rawId) : [];
const live = match && match.status === 'scheduled' ? await getLiveMatch(rawId) : null;
if (!match) Astro.response.status = 404;

const matchTimeLabel = match
	? isTbdVenue(match.venue_maps)
		? formatTurno(match.time) || formatTime(match.time)
		: formatTime(match.time)
	: '';

const isLive = Boolean(live);
const isFinished = match?.status === 'finished' || match?.status === 'forfeit';

// Unified stats (live or finished) for Resumen (Jugador destacado) and Tiros
const liveStats: { home: LivePlayerStat[]; away: LivePlayerStat[] } | null =
	live?.stats_json ? JSON.parse(live.stats_json) : null;

const homeRows = rows.filter((r) => r.team_id === match?.home_id);
const awayRows = rows.filter((r) => r.team_id === match?.away_id);

const unifiedHomePlayers: LivePlayerStat[] = liveStats
	? liveStats.home ?? []
	: homeRows.map((r) => ({
			number: r.player_number ?? '–',
			name: r.player_name,
			points: r.points,
			fg2: r.fg,
			fg3: r.three,
			ftm: r.ft_made,
			fta: r.ft_att,
			fouls: r.fouls,
		}));

const unifiedAwayPlayers: LivePlayerStat[] = liveStats
	? liveStats.away ?? []
	: awayRows.map((r) => ({
			number: r.player_number ?? '–',
			name: r.player_name,
			points: r.points,
			fg2: r.fg,
			fg3: r.three,
			ftm: r.ft_made,
			fta: r.ft_att,
			fouls: r.fouls,
		}));

function pickBestPlayer(list: LivePlayerStat[]): LivePlayerStat | null {
	if (!list.length) return null;
	const sorted = [...list].sort((a, b) => {
		if (b.points !== a.points) return b.points - a.points;
		if (b.fg3 !== a.fg3) return b.fg3 - a.fg3;
		if (b.fg2 !== a.fg2) return b.fg2 - a.fg2;
		return a.fouls - b.fouls;
	});
	return sorted[0].points > 0 ? sorted[0] : sorted[0];
}

const bestHome = pickBestPlayer(unifiedHomePlayers);
const bestAway = pickBestPlayer(unifiedAwayPlayers);
const overallMvp =
	bestHome && bestAway
		? bestHome.points >= bestAway.points
			? { ...bestHome, teamName: match?.home_team ?? '' }
			: { ...bestAway, teamName: match?.away_team ?? '' }
		: bestHome
			? { ...bestHome, teamName: match?.home_team ?? '' }
			: bestAway
				? { ...bestAway, teamName: match?.away_team ?? '' }
				: null;

// Quarters (live or finished)
const homePeriods = live
	? [live.home_q1, live.home_q2, live.home_q3, live.home_q4, live.home_ot1, live.home_ot2, live.home_ot3]
	: [
			match?.home_q1 ?? null,
			match?.home_q2 ?? null,
			match?.home_q3 ?? null,
			match?.home_q4 ?? null,
			match?.home_ot1 ?? null,
			match?.home_ot2 ?? null,
			match?.home_ot3 ?? null,
		];
const awayPeriods = live
	? [live.away_q1, live.away_q2, live.away_q3, live.away_q4, live.away_ot1, live.away_ot2, live.away_ot3]
	: [
			match?.away_q1 ?? null,
			match?.away_q2 ?? null,
			match?.away_q3 ?? null,
			match?.away_q4 ?? null,
			match?.away_ot1 ?? null,
			match?.away_ot2 ?? null,
			match?.away_ot3 ?? null,
		];
const hasQuarterScores = [...homePeriods, ...awayPeriods].some((v) => v != null);

const periodLabels = ['Q1', 'Q2', 'Q3', 'Q4', 'PR1', 'PR2', 'PR3'];
const otCount = [4, 5, 6].filter((i) => homePeriods[i] != null || awayPeriods[i] != null).length;
const visibleQuarterCount = Math.max(4, live ? Math.min(7, live.period) : 4 + otCount);
const visibleQuarterLabels = periodLabels.slice(0, visibleQuarterCount);

// Play-by-play (live or saved on finished match)
const initialPbp: PbpEvent[] = (() => {
	const raw = live?.pbp_json || match?.pbp_json;
	if (!raw) return [];
	try {
		const parsed = JSON.parse(raw);
		return Array.isArray(parsed) ? [...parsed].reverse() : [];
	} catch {
		return [];
	}
})();

const hasMatchContent = isLive || isFinished || rows.length > 0 || hasQuarterScores || initialPbp.length > 0;

const totals = (list: BoxScoreRow[]) =>
	list.reduce(
		(acc, r) => ({
			points: acc.points + r.points,
			fg: acc.fg + r.fg,
			three: acc.three + r.three,
			ft_made: acc.ft_made + r.ft_made,
			ft_att: acc.ft_att + r.ft_att,
			fouls: acc.fouls + r.fouls,
		}),
		{ points: 0, fg: 0, three: 0, ft_made: 0, ft_att: 0, fouls: 0 },
	);

const liveTotals = (list: LivePlayerStat[]) =>
	list.reduce(
		(acc, r) => ({
			points: acc.points + (r.points || 0),
			fg2: acc.fg2 + (r.fg2 || 0),
			fg3: acc.fg3 + (r.fg3 || 0),
			ftm: acc.ftm + (r.ftm || 0),
			fta: acc.fta + (r.fta || 0),
			fouls: acc.fouls + (r.fouls || 0),
		}),
		{ points: 0, fg2: 0, fg3: 0, ftm: 0, fta: 0, fouls: 0 },
	);

const statHeader = ['P', '2P', '3P', 'TL', 'TLI', 'Fal'];
const boxColumns = [
	{ label: 'Jugador', align: 'text-left' },
	...statHeader.map((label) => ({ label, align: 'text-right' })),
];

const homeOutcome = match ? teamOutcome(match, 'home') : null;
const awayOutcome = match ? teamOutcome(match, 'away') : null;
const moved = match ? movedLabel(match.original_date, match.date) : null;
const nameClasses = (outcome: TeamOutcome | null, align: '' | 'text-right') => {
	const base = `truncate font-display uppercase tracking-wide ${align}`;
	if (!outcome) return `${base} text-lg sm:text-3xl`;
	if (outcome === 'win')
		return `${base} rounded-lg bg-emerald-100 px-3 py-1 text-xl text-emerald-700 sm:text-3xl`;
	return `${base} rounded-lg bg-rose-100 px-3 py-1 text-xl text-rose-700 sm:text-3xl`;
};

const displayHomeScore = live ? live.home_score : match?.home_score ?? null;
const displayAwayScore = live ? live.away_score : match?.away_score ?? null;
---

<Layout
	title={
		match
			? `${match.home_team} vs ${match.away_team} · Liga Elche Baloncesto`
			: 'Partido · Liga Elche Baloncesto'
	}
	description={
		match
			? `Resultado y estadísticas de ${match.home_team} contra ${match.away_team}, jornada ${match.week} de la Liga Elche Baloncesto.`
			: undefined
	}
>
	{
		match ? (
			<div
				class="mx-auto max-w-5xl px-4 pt-4 pb-6"
				id="match-page-root"
				data-match-id={match.id}
				data-match-status={match.status}
				data-home-name={match.home_team}
				data-away-name={match.away_team}
				data-home-short={match.home_short}
				data-away-short={match.away_short}
			>
				<div class="flex items-center justify-between gap-3 sm:hidden">
					<div class="flex min-w-0 flex-col text-sm text-gray-500">
						<a
							href="/calendario"
							class="text-sm font-medium text-[#79131f] hover:underline"
						>
							← Calendario
						</a>
						<h1 class="mt-1 font-display text-3xl tracking-wide text-black">
							Jornada {match.week}
						</h1>
						<div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1">
							{match.time && <span set:html={matchTimeLabel} />}
							<span class="mr-1">{formatDate(match.date)}</span>
							{match.venue_name && (
								<VenueLink
									name={match.venue_name}
									short={match.venue_short}
									mapsUrl={match.venue_maps}
									class="hover:text-[#79131f] hover:underline"
								/>
							)}
						</div>
					</div>
					<span class="flex shrink-0 items-center gap-2">
						<a href={`/equipos/${match.home_id}`} class="shrink-0">
							<TeamBadge
								bare
								size="xl"
								logoUrl={match.home_logo}
								name={match.home_team}
								shortName={match.home_short}
							/>
						</a>
						<span class="font-display text-2xl text-black">VS</span>
						<a href={`/equipos/${match.away_id}`} class="shrink-0">
							<TeamBadge
								bare
								size="xl"
								logoUrl={match.away_logo}
								name={match.away_team}
								shortName={match.away_short}
							/>
						</a>
					</span>
				</div>

				<p class="hidden sm:block">
					<a
						href="/calendario"
						class="text-sm font-medium text-[#79131f] hover:underline"
					>
						← Calendario
					</a>
				</p>

				<h1 class="mt-3 hidden font-display text-3xl tracking-wide text-black sm:block">
					Jornada {match.week}
				</h1>
				<div class="mt-1 hidden flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-500 sm:flex">
					{match.time && <span set:html={matchTimeLabel} />}
					<span class="mr-2">{formatDate(match.date)}</span>
					{match.venue_name && (
						<VenueLink
							name={match.venue_name}
							short={match.venue_short}
							mapsUrl={match.venue_maps}
							class="hover:text-[#79131f] hover:underline"
						/>
					)}
				</div>

				{/* Hero scoreboard (always visible above tabs) */}
				<div class="mt-4 flex items-center justify-between gap-2 rounded-2xl border border-gray-200 bg-white p-3 shadow-sm sm:gap-4 sm:p-5">
					<div class="flex min-w-0 flex-1 items-center gap-2 sm:justify-between">
						<a
							href={`/equipos/${match.home_id}`}
							class={`${nameClasses(homeOutcome, '')} transition hover:opacity-80`}
							title={match.home_team}
							data-name-full={match.home_team}
							data-name-short={match.home_short}
						>
							{match.home_short}
						</a>
						<a href={`/equipos/${match.home_id}`} class="hidden sm:inline-flex">
							<TeamBadge
								bare
								size="xl"
								logoUrl={match.home_logo}
								name={match.home_team}
								shortName={match.home_short}
							/>
						</a>
					</div>
					<div id="hero-score-wrap" class="shrink-0">
						{live ? (
							<span class="inline-flex shrink-0 items-center rounded-lg bg-gray-900 px-3 py-1.5 font-display text-2xl tracking-wider tabular-nums text-white ring-2 ring-red-500/70 sm:rounded-xl sm:px-6 sm:py-2.5 sm:text-4xl">
								{`${live.home_score} – ${live.away_score}`}
							</span>
						) : (
							<ScoreBadge
								home={match.home_score}
								away={match.away_score}
								variant="hero"
							/>
						)}
					</div>
					<div class="flex min-w-0 flex-1 items-center justify-end gap-2 sm:justify-between">
						<a href={`/equipos/${match.away_id}`} class="hidden sm:inline-flex">
							<TeamBadge
								bare
								size="xl"
								logoUrl={match.away_logo}
								name={match.away_team}
								shortName={match.away_short}
							/>
						</a>
						<a
							href={`/equipos/${match.away_id}`}
							class={`${nameClasses(awayOutcome, 'text-right')} transition hover:opacity-80`}
							title={match.away_team}
							data-name-full={match.away_team}
							data-name-short={match.away_short}
						>
							{match.away_short}
						</a>
					</div>
				</div>

				{/* Live status strip (visible when live, or dynamically revealed by poller) */}
				{match.status === 'scheduled' && (
					<div
						id="live-banner"
						class:list={[
							'mt-3 flex flex-wrap items-center justify-between gap-2 rounded-xl border border-red-200 bg-red-50 px-4 py-2.5 text-sm',
							!live && 'hidden',
						]}
					>
						<div class="flex items-center gap-2 font-semibold text-red-700">
							<span class="h-2.5 w-2.5 animate-pulse rounded-full bg-red-600" />
							<span>EN DIRECTO</span>
							<span id="live-period" class="rounded bg-red-600 px-1.5 py-0.5 text-xs text-white">
								{live ? (live.period > 4 ? `PR${live.period - 4}` : `Q${live.period}`) : 'Q1'}
							</span>
							<span id="live-clock" class="font-mono text-base text-red-900">
								{live
									? `${String(Math.floor(live.clock_ms / 60000)).padStart(2, '0')}:${String(Math.floor((live.clock_ms % 60000) / 1000)).padStart(2, '0')}`
									: '10:00'}
							</span>
						</div>
						<span class="text-xs text-red-600/80">Actualización automática desde el acta</span>
					</div>
				)}

				{/* Empty state for scheduled matches not yet started */}
				{!hasMatchContent && (
					<div
						id="empty-stats-banner"
						class="mt-6 rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center text-gray-500"
					>
						Aún no hay estadísticas de jugadores para este partido
					</div>
				)}

				{/* Unified 3-tab view (Resumen · Tiros · Jugadas) for both Live and Finished */}
				<div id="match-tabs-shell" class:list={['mt-5', !hasMatchContent && 'hidden']}>
					<div
						role="tablist"
						aria-label="Secciones del partido"
						class="grid grid-cols-3 gap-1 rounded-xl border border-gray-200 bg-gray-100 p-1"
					>
						<button
							type="button"
							role="tab"
							data-match-tab="resumen"
							aria-selected="true"
							class="match-tab-btn rounded-lg bg-white px-3 py-2 text-sm font-semibold text-[#641B24] shadow-sm transition"
						>
							Resumen
						</button>
						<button
							type="button"
							role="tab"
							data-match-tab="tiros"
							aria-selected="false"
							class="match-tab-btn rounded-lg px-3 py-2 text-sm font-semibold text-gray-600 transition hover:text-gray-900"
						>
							Tiros
						</button>
						<button
							type="button"
							role="tab"
							data-match-tab="jugadas"
							aria-selected="false"
							class="match-tab-btn rounded-lg px-3 py-2 text-sm font-semibold text-gray-600 transition hover:text-gray-900"
						>
							Jugadas
						</button>
					</div>

					{/* TAB 1: RESUMEN (Marcador total + Puntos por cuartos + Jugador destacado) */}
					<div id="tab-resumen" data-tab-panel="resumen" class="mt-4 space-y-5">
						{/* Puntos por cuartos */}
						<section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
							<div class="flex items-center justify-between border-b border-gray-200 bg-gray-50 px-4 py-2.5">
								<h2 class="text-xs font-semibold tracking-wide text-gray-600 uppercase">
									Puntos por cuartos
								</h2>
								{isFinished && (
									<span class="rounded-full bg-gray-200 px-2 py-0.5 text-[10px] font-semibold tracking-wider text-gray-700 uppercase">
										Final
									</span>
								)}
							</div>
							<div id="resumen-quarters" class="overflow-x-auto">
								{hasQuarterScores || isLive ? (
									<table class="w-full text-center text-sm">
										<thead class="border-b border-gray-100 bg-gray-50/50 text-xs text-gray-500">
											<tr>
												<th class="px-4 py-2 text-left font-medium">Equipo</th>
												{visibleQuarterLabels.map((lbl) => (
													<th class="px-2.5 py-2 font-medium">{lbl}</th>
												))}
												<th class="px-4 py-2 text-right font-bold text-gray-700">Total</th>
											</tr>
										</thead>
										<tbody>
											<tr class="border-b border-gray-100">
												<td class="px-4 py-2.5 text-left font-medium text-gray-900">
													{match.home_team}
												</td>
												{visibleQuarterLabels.map((_, i) => (
													<td class="px-2.5 py-2.5 tabular-nums text-gray-700">
														{homePeriods[i] ?? '–'}
													</td>
												))}
												<td class="px-4 py-2.5 text-right font-bold tabular-nums text-gray-900">
													{displayHomeScore ?? '–'}
												</td>
											</tr>
											<tr>
												<td class="px-4 py-2.5 text-left font-medium text-gray-900">
													{match.away_team}
												</td>
												{visibleQuarterLabels.map((_, i) => (
													<td class="px-2.5 py-2.5 tabular-nums text-gray-700">
														{awayPeriods[i] ?? '–'}
													</td>
												))}
												<td class="px-4 py-2.5 text-right font-bold tabular-nums text-gray-900">
													{displayAwayScore ?? '–'}
												</td>
											</tr>
										</tbody>
									</table>
								) : (
									<p class="p-4 text-center text-sm text-gray-500">
										Sin parciales por cuartos registrados.
									</p>
								)}
							</div>
						</section>

						{/* Jugador destacado */}
						<section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
							<div class="border-b border-gray-200 bg-gray-50 px-4 py-2.5">
								<h2 class="text-xs font-semibold tracking-wide text-gray-600 uppercase">
									Jugador destacado
								</h2>
							</div>
							<div id="resumen-mvp" class="p-4">
								{overallMvp ? (
									<div class="space-y-4">
										<div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-amber-200 bg-amber-50/70 p-4">
											<div class="min-w-0">
												<span class="inline-flex items-center gap-1 rounded-full bg-amber-500 px-2 py-0.5 text-[10px] font-bold tracking-wider text-white uppercase">
													★ Destacado del partido
												</span>
												<p class="mt-1.5 truncate text-lg font-bold text-gray-900">
													<span class="mr-1.5 font-mono text-sm text-gray-500">
														#{overallMvp.number}
													</span>
													{overallMvp.name}
												</p>
												<p class="text-xs font-medium text-gray-600">
													{overallMvp.teamName}
												</p>
											</div>
											<div class="flex items-center gap-4 text-center">
												<div>
													<div class="font-display text-3xl leading-none text-[#641B24] tabular-nums">
														{overallMvp.points}
													</div>
													<div class="mt-0.5 text-[10px] font-semibold text-gray-500 uppercase">
														PTS
													</div>
												</div>
												<div class="h-8 w-px bg-amber-200" />
												<div class="flex gap-3 text-xs tabular-nums text-gray-700">
													<div>
														<div class="font-semibold">{overallMvp.fg2}</div>
														<div class="text-[10px] text-gray-500">2P</div>
													</div>
													<div>
														<div class="font-semibold">{overallMvp.fg3}</div>
														<div class="text-[10px] text-gray-500">3P</div>
													</div>
													<div>
														<div class="font-semibold">
															{overallMvp.ftm}/{overallMvp.fta}
														</div>
														<div class="text-[10px] text-gray-500">TL</div>
													</div>
													<div>
														<div class="font-semibold">{overallMvp.fouls}</div>
														<div class="text-[10px] text-gray-500">FAL</div>
													</div>
												</div>
											</div>
										</div>

										{(bestHome || bestAway) && (
											<div class="grid gap-3 sm:grid-cols-2">
												{[
													{ label: match.home_team, player: bestHome },
													{ label: match.away_team, player: bestAway },
												].map(
													({ label, player }) =>
														player && (
															<div class="flex items-center justify-between gap-3 rounded-lg border border-gray-200 bg-gray-50/70 px-3.5 py-2.5">
																<div class="min-w-0">
																	<p class="text-[11px] font-semibold tracking-wide text-gray-500 uppercase">
																		{label}
																	</p>
																	<p class="truncate text-sm font-semibold text-gray-900">
																		<span class="mr-1 font-mono text-xs text-gray-400">
																			#{player.number}
																		</span>
																		{player.name}
																	</p>
																</div>
																<div class="shrink-0 text-right tabular-nums">
																	<span class="font-display text-2xl text-gray-900">
																		{player.points}
																	</span>
																	<span class="ml-1 text-[10px] font-semibold text-gray-500 uppercase">
																		pts
																	</span>
																</div>
