																{t.fg}
															</td>
															<td class="px-3 py-2 text-right tabular-nums">
																{t.three}
															</td>
															<td class="px-3 py-2 text-right tabular-nums">
																{t.ft_made}
															</td>
															<td class="px-3 py-2 text-right tabular-nums">
																{t.ft_att}
															</td>
															<td class="px-3 py-2 text-right tabular-nums">
																{t.fouls}
															</td>
														</tr>
													</tfoot>
												</table>
											</div>
										</section>
									);
								})
							) : (
								<div class="col-span-2 rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center text-gray-500">
									Aún no hay estadísticas de tiros para este partido.
								</div>
							)}
						</div>
					</div>

					{/* TAB 3: JUGADAS (Últimas jugadas / Play-by-play) */}
					<div id="tab-jugadas" data-tab-panel="jugadas" class="mt-4 hidden">
						<section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
							<div class="border-b border-gray-200 bg-gray-50 px-4 py-2.5">
								<h2 class="text-xs font-semibold tracking-wide text-gray-600 uppercase">
									Últimas jugadas
								</h2>
							</div>
							<div id="jugadas-list" class="divide-y divide-gray-100">
								{initialPbp.length > 0 ? (
									initialPbp.map((ev) => (
										<div class="flex items-center justify-between gap-3 px-4 py-3 text-sm">
											<div class="flex min-w-0 items-center gap-2.5">
												<span class="shrink-0 text-base">{ev.icon || '•'}</span>
												<div class="min-w-0">
													<p class="font-medium text-gray-900">
														{ev.desc || ev.txt || ev.text || ''}
													</p>
													{ev.team && (
														<p class="mt-0.5 flex items-center gap-1.5 text-xs text-gray-500">
															<span
																class="inline-block h-2 w-2 rounded-full"
																style={`background:${ev.color || '#641B24'}`}
															/>
