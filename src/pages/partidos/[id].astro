</Layout>

<script>
	import '../../lib/team-names';
	import '../../lib/table-interactions';

	// Acta photo modal
	const dialog = document.getElementById('acta-dialog') as HTMLDialogElement | null;
	const openBtn = document.querySelector<HTMLButtonElement>('[data-acta-open]');
	const closeBtn = document.querySelector<HTMLButtonElement>('[data-acta-close]');

	if (dialog && openBtn) {
		openBtn.addEventListener('click', () => dialog.showModal());
		closeBtn?.addEventListener('click', () => dialog.close());
		dialog.addEventListener('click', (event) => {
			const target = event.target as HTMLElement | null;
			const isPhoto = target?.closest('img') != null;
			if (isPhoto) return;
			if (target === dialog || target?.hasAttribute('data-acta-backdrop')) dialog.close();
		});
	}

	// 3-tab switching (Resumen / Tiros / Jugadas)
	const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-match-tab]'));
	const tabPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-tab-panel]'));

	const setActiveTab = (tabName: string) => {
		tabButtons.forEach((btn) => {
			const active = btn.dataset.matchTab === tabName;
			btn.setAttribute('aria-selected', active ? 'true' : 'false');
			btn.className = active
				? 'match-tab-btn rounded-lg bg-white px-3 py-2 text-sm font-semibold text-[#641B24] shadow-sm transition'
				: 'match-tab-btn rounded-lg px-3 py-2 text-sm font-semibold text-gray-600 transition hover:text-gray-900';
		});
		tabPanels.forEach((panel) => {
			panel.classList.toggle('hidden', panel.dataset.tabPanel !== tabName);
		});
	};

	tabButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			if (btn.dataset.matchTab) setActiveTab(btn.dataset.matchTab);
		});
	});

	// Live polling for scheduled matches (updates Hero + Resumen + Tiros + Jugadas without changing active tab)
	const root = document.getElementById('match-page-root') as HTMLElement | null;
	if (root && root.dataset.matchStatus === 'scheduled') {
		const matchId = root.dataset.matchId;
		const homeName = root.dataset.homeName || 'Local';
		const awayName = root.dataset.awayName || 'Visitante';
		const heroWrap = document.getElementById('hero-score-wrap');
		const liveBanner = document.getElementById('live-banner');
		const emptyBanner = document.getElementById('empty-stats-banner');
		const tabsShell = document.getElementById('match-tabs-shell');
		const periodEl = document.getElementById('live-period');
		const clockEl = document.getElementById('live-clock');
		const resumenQuartersEl = document.getElementById('resumen-quarters');
		const resumenMvpEl = document.getElementById('resumen-mvp');
		const tirosBoxEl = document.getElementById('tiros-boxscore');
		const jugadasListEl = document.getElementById('jugadas-list');

		const esc = (s: unknown) =>
			String(s ?? '').replace(
				/[&<>"]/g,
				(c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] || c,
			);

		const fmtClock = (ms: number) => {
			const sec = Math.max(0, Math.floor(ms / 1000));
			return `${String(Math.floor(sec / 60)).padStart(2, '0')}:${String(sec % 60).padStart(2, '0')}`;
		};

		const pickBest = (list: any[]) => {
			if (!list || !list.length) return null;
			return [...list].sort((a, b) => {
				if ((b.points || 0) !== (a.points || 0)) return (b.points || 0) - (a.points || 0);
				if ((b.fg3 || 0) !== (a.fg3 || 0)) return (b.fg3 || 0) - (a.fg3 || 0);
				if ((b.fg2 || 0) !== (a.fg2 || 0)) return (b.fg2 || 0) - (a.fg2 || 0);
				return (a.fouls || 0) - (b.fouls || 0);
			})[0];
		};

		const renderMvp = (homeList: any[], awayList: any[]) => {
			const bh = pickBest(homeList);
			const ba = pickBest(awayList);
			const mvp =
				bh && ba
					? (bh.points || 0) >= (ba.points || 0)
						? { ...bh, teamName: homeName }
						: { ...ba, teamName: awayName }
					: bh
						? { ...bh, teamName: homeName }
						: ba
							? { ...ba, teamName: awayName }
							: null;

			if (!mvp) {
				return '<p class="text-center text-sm text-gray-500">Aún no hay anotadores registrados.</p>';
			}

			const miniCards = [
				{ label: homeName, player: bh },
				{ label: awayName, player: ba },
			]
				.filter((x) => x.player)
				.map(
					({ label, player }) => `<div class="flex items-center justify-between gap-3 rounded-lg border border-gray-200 bg-gray-50/70 px-3.5 py-2.5">
						<div class="min-w-0">
							<p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500">${esc(label)}</p>
							<p class="truncate text-sm font-semibold text-gray-900"><span class="mr-1 font-mono text-xs text-gray-400">#${esc(player.number)}</span>${esc(player.name)}</p>
						</div>
						<div class="shrink-0 text-right tabular-nums">
							<span class="font-display text-2xl text-gray-900">${player.points ?? 0}</span>
							<span class="ml-1 text-[10px] font-semibold uppercase text-gray-500">pts</span>
						</div>
					</div>`,
				)
				.join('');

			return `<div class="space-y-4">
				<div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-amber-200 bg-amber-50/70 p-4">
					<div class="min-w-0">
						<span class="inline-flex items-center gap-1 rounded-full bg-amber-500 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white">★ Destacado del partido</span>
						<p class="mt-1.5 truncate text-lg font-bold text-gray-900"><span class="mr-1.5 font-mono text-sm text-gray-500">#${esc(mvp.number)}</span>${esc(mvp.name)}</p>
						<p class="text-xs font-medium text-gray-600">${esc(mvp.teamName)}</p>
					</div>
					<div class="flex items-center gap-4 text-center">
						<div>
							<div class="font-display text-3xl leading-none tabular-nums text-[#641B24]">${mvp.points ?? 0}</div>
							<div class="mt-0.5 text-[10px] font-semibold uppercase text-gray-500">PTS</div>
						</div>
						<div class="h-8 w-px bg-amber-200"></div>
						<div class="flex gap-3 text-xs tabular-nums text-gray-700">
							<div><div class="font-semibold">${mvp.fg2 ?? 0}</div><div class="text-[10px] text-gray-500">2P</div></div>
							<div><div class="font-semibold">${mvp.fg3 ?? 0}</div><div class="text-[10px] text-gray-500">3P</div></div>
							<div><div class="font-semibold">${mvp.ftm ?? 0}/${mvp.fta ?? 0}</div><div class="text-[10px] text-gray-500">TL</div></div>
							<div><div class="font-semibold">${mvp.fouls ?? 0}</div><div class="text-[10px] text-gray-500">FAL</div></div>
						</div>
					</div>
				</div>
				<div class="grid gap-3 sm:grid-cols-2">${miniCards}</div>
			</div>`;
		};

		const renderTeamTable = (title: string, list: any[]) => {
			if (!list || !list.length) return '';
			const totals = list.reduce(
				(acc, p) => ({
					points: acc.points + (p.points || 0),
					fg2: acc.fg2 + (p.fg2 || 0),
					fg3: acc.fg3 + (p.fg3 || 0),
					ftm: acc.ftm + (p.ftm || 0),
					fta: acc.fta + (p.fta || 0),
					fouls: acc.fouls + (p.fouls || 0),
				}),
				{ points: 0, fg2: 0, fg3: 0, ftm: 0, fta: 0, fouls: 0 },
			);
			const rowsHtml = list
				.map(
					(p) => `<tr class="border-b border-gray-100 last:border-0">
						<td class="px-3 py-2 text-left text-sm font-medium"><span class="mr-1 font-mono text-xs text-gray-400">#${esc(p.number)}</span>${esc(p.name)}</td>
						<td class="px-2.5 py-2 text-right font-semibold tabular-nums">${p.points ?? 0}</td>
						<td class="px-2.5 py-2 text-right tabular-nums text-gray-600">${p.fg2 ?? 0}</td>
						<td class="px-2.5 py-2 text-right tabular-nums text-gray-600">${p.fg3 ?? 0}</td>
						<td class="px-2.5 py-2 text-right tabular-nums text-gray-600">${p.ftm ?? 0}</td>
						<td class="px-2.5 py-2 text-right tabular-nums text-gray-600">${p.fta ?? 0}</td>
						<td class="px-2.5 py-2 text-right tabular-nums ${(p.fouls ?? 0) >= 5 ? 'font-bold text-[#641B24]' : 'text-gray-600'}">${p.fouls ?? 0}</td>
					</tr>`,
				)
				.join('');
			return `<section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
				<h2 class="border-b border-gray-200 bg-gray-50 px-4 py-3 font-semibold">${esc(title)}</h2>
				<div class="overflow-x-auto"><table class="w-full text-sm">
					<thead>
						<tr class="border-b border-gray-200 text-left text-xs uppercase tracking-wide text-gray-500">
							<th class="px-3 py-2.5 text-left font-medium">Jugador</th>
							<th class="px-2.5 py-2.5 text-right font-medium">P</th>
							<th class="px-2.5 py-2.5 text-right font-medium">2P</th>
							<th class="px-2.5 py-2.5 text-right font-medium">3P</th>
							<th class="px-2.5 py-2.5 text-right font-medium">TL</th>
							<th class="px-2.5 py-2.5 text-right font-medium">TLI</th>
							<th class="px-2.5 py-2.5 text-right font-medium">Fal</th>
						</tr>
					</thead>
					<tbody>${rowsHtml}</tbody>
					<tfoot>
						<tr class="border-t-2 border-gray-200 bg-gray-50 font-semibold">
							<td class="px-3 py-2">Totales</td>
							<td class="px-2.5 py-2 text-right tabular-nums">${totals.points}</td>
							<td class="px-2.5 py-2 text-right tabular-nums">${totals.fg2}</td>
							<td class="px-2.5 py-2 text-right tabular-nums">${totals.fg3}</td>
							<td class="px-2.5 py-2 text-right tabular-nums">${totals.ftm}</td>
							<td class="px-2.5 py-2 text-right tabular-nums">${totals.fta}</td>
							<td class="px-2.5 py-2 text-right tabular-nums">${totals.fouls}</td>
						</tr>
					</tfoot>
				</table></div>
			</section>`;
		};

		let wasLive = Boolean(liveBanner && !liveBanner.classList.contains('hidden'));

		const pollLive = async () => {
			if (!matchId || document.hidden) return;
			try {
				const res = await fetch(`/api/live/${matchId}`, { cache: 'no-store' });
				if (!res.ok) return;
				const data = await res.json();

				if (!data.live) {
					if (data.status === 'finished' || data.status === 'forfeit' || wasLive) {
						window.location.reload();
					}
					return;
				}

				wasLive = true;
				liveBanner?.classList.remove('hidden');
				tabsShell?.classList.remove('hidden');
				emptyBanner?.classList.add('hidden');

				if (heroWrap) {
					heroWrap.innerHTML = `<span class="inline-flex shrink-0 items-center rounded-lg bg-gray-900 px-3 py-1.5 font-display text-2xl tracking-wider tabular-nums text-white ring-2 ring-red-500/70 sm:rounded-xl sm:px-6 sm:py-2.5 sm:text-4xl">${data.home_score ?? 0} – ${data.away_score ?? 0}</span>`;
				}
				if (periodEl) {
					periodEl.textContent = data.period > 4 ? `PR${data.period - 4}` : `Q${data.period || 1}`;
				}
				if (clockEl) {
					clockEl.textContent = fmtClock(Number(data.clock_ms ?? 0));
				}

				if (resumenQuartersEl && data.quarters) {
					const labels = ['Q1', 'Q2', 'Q3', 'Q4', 'PR1', 'PR2', 'PR3'];
					const cols = labels.slice(0, Math.min(labels.length, Math.max(4, Number(data.period || 1))));
					resumenQuartersEl.innerHTML = `<table class="w-full text-center text-sm">
						<thead class="border-b border-gray-100 bg-gray-50/50 text-xs text-gray-500">
							<tr><th class="px-4 py-2 text-left font-medium">Equipo</th>${cols.map((c) => `<th class="px-2.5 py-2 font-medium">${c}</th>`).join('')}<th class="px-4 py-2 text-right font-bold text-gray-700">Total</th></tr>
						</thead>
						<tbody>
							<tr class="border-b border-gray-100"><td class="px-4 py-2.5 text-left font-medium text-gray-900">${esc(homeName)}</td>${cols.map((_, i) => `<td class="px-2.5 py-2.5 tabular-nums text-gray-700">${data.quarters.home[i] ?? '–'}</td>`).join('')}<td class="px-4 py-2.5 text-right font-bold tabular-nums text-gray-900">${data.home_score ?? 0}</td></tr>
							<tr><td class="px-4 py-2.5 text-left font-medium text-gray-900">${esc(awayName)}</td>${cols.map((_, i) => `<td class="px-2.5 py-2.5 tabular-nums text-gray-700">${data.quarters.away[i] ?? '–'}</td>`).join('')}<td class="px-4 py-2.5 text-right font-bold tabular-nums text-gray-900">${data.away_score ?? 0}</td></tr>
						</tbody>
					</table>`;
				}

				if (data.players) {
					const hList = data.players.home || [];
					const aList = data.players.away || [];
					if (resumenMvpEl) {
						resumenMvpEl.innerHTML = renderMvp(hList, aList);
					}
					if (tirosBoxEl) {
						tirosBoxEl.innerHTML = renderTeamTable(homeName, hList) + renderTeamTable(awayName, aList);
					}
				}

				if (jugadasListEl && Array.isArray(data.pbp)) {
					const plays = [...data.pbp].reverse();
					if (plays.length === 0) {
						jugadasListEl.innerHTML =
							'<p class="p-8 text-center text-sm text-gray-500">Aún no hay jugadas registradas para este partido.</p>';
					} else {
						jugadasListEl.innerHTML = plays
							.map(
								(ev: any) => `<div class="flex items-center justify-between gap-3 px-4 py-3 text-sm">
									<div class="flex min-w-0 items-center gap-2.5">
										<span class="shrink-0 text-base">${esc(ev.icon || '•')}</span>
										<div class="min-w-0">
											<p class="font-medium text-gray-900">${esc(ev.desc || ev.txt || ev.text || '')}</p>
											${ev.team ? `<p class="mt-0.5 flex items-center gap-1.5 text-xs text-gray-500"><span class="inline-block h-2 w-2 rounded-full" style="background:${esc(ev.color || '#641B24')}"></span>${esc(ev.team)}</p>` : ''}
										</div>
									</div>
									<div class="flex shrink-0 items-center gap-1.5 font-mono text-xs text-gray-500">
										${ev.per != null ? `<span class="rounded bg-gray-100 px-1.5 py-0.5 font-semibold text-gray-700">${ev.per > 4 ? `PR${ev.per - 4}` : `Q${ev.per}`}</span>` : ''}
										<span>${esc(ev.clk || ev.time || '')}</span>
									</div>
								</div>`,
							)
							.join('');
					}
				}
			} catch {
				// Ignore transient network errors during polling
			}
		};

		pollLive();
		setInterval(pollLive, 3000);
	}
</script>

<style is:global>
	#acta-dialog::backdrop {
		background-color: rgb(0 0 0 / 0.7);
	}
</style>
